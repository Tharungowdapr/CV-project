# Vehicle Re-ID Environment Configuration

APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Security
SECRET_KEY=dev-secret-key-do-not-use-in-prod
API_KEYS=dev-key:analyst,admin-key:admin

# Paths
DATA_ROOT=./data
ARTIFACT_ROOT=./outputs
MODEL_REGISTRY_PATH=./models

# Hardware
# Set to 'cuda' or 'cpu'
DEVICE=cuda

# --- LIVE TRAFFIC CAMERA CONFIGURATION ---

# ID of the primary camera
CAMERA_ID=cam_01

# The URL of the video stream.
# - For local webcam, use "0"
# - For an RTSP IP camera, use "rtsp://username:password@ip_address/stream"
# - For an HTTP/MJPEG stream, use "http://ip_address/stream/video.mjpeg"
# - For a pre-recorded test video, use "data/traffic_test.mp4"
STREAM_URL=0
